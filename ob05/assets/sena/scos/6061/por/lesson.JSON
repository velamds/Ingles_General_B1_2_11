ontent": ""}], "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "RSLT", "id": 10, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}]}, {"questions": [{"id": 0, "_data": [{"contents": [{"type": "pdf", "content": "engenn7le11ob05re7pdf01.pdf"}], "type": "question"}], "responses": [{"correct": 1, "id": 0, "_data": [{"type": "text", "content": ""}], "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "id": 11, "_data": [{"contents": [{"type": "text", "content": " Write a presentation for a speed dating event."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}], "type": "post_instructions"}]}], "type": "scholar", "stimuli": [{"contents": [{}], "type": "welcome", "id": 0, "_data": [], "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"audiosrc": "engenn7le11ob05re2aud01", "images": [{"time": "0", "text": "", "id": 0, "image": "engenn7le11ob05re2img05.jpg"}, {"time": "100", "text": "<span class=\"strong\">Peter</span>:        Hey Mike, can I ask you something?<br/>\n<span class=\"strong\">Mike</span>:        Sure. What's up?     <br/>\n<span class=\"strong\">Peter</span>:        Have you ever tried speed dating before?<br/>\n<span class=\"strong\">Mike</span>:        Yeah, I have, a couple of times. It was really fun. I met a few girls who were into the same kinds of things as me.", "id": 1, "image": "engenn7le11ob05re2img05.jpg"}, {"time": "15500", "text": "<span class=\"strong\">Peter</span>:        It must have been a good experience, then! I'm having the hardest time finding someone who thinks I'm interesting these days. Every time I try to speak to a girl that I like, they seem so bored by what I'm saying.<br/>\n<span class=\"strong\">Mike</span>:        Speed dating can be a daunting experience at first. You may have been a bit nervous, I guess. You have to focus on making an impact, which means that you only have a couple of minutes to show them how captivating you can be.", "id": 2, "image": "engenn7le11ob05re2img01.jpg"}, {"time": "46000", "text": "<span class=\"strong\">Peter</span>:        That must be easy for you! Everyone in the office is always thrilled to hear your stories. I'm the kind of rambling guy who can't even say a joke properly!<br/>\n<span class=\"strong\">Mike</span>:        You must think that it's the only way to get people engaged, but that's not true. Sometimes, it's what you don't say that makes the conversation interesting. Try to be more relaxed. Practice makes perfect! You might not have heard this before!<br/>\n<span class=\"strong\">Peter</span>:        Thanks for nothing, Mike ...", "id": 3, "image": "engenn7le11ob05re2img02.jpg"}], "coverimg": "engenn7le11ob05re2img05.jpg"}}], "template_override": 1, "type": "audio", "title": "", "_data": [], "id": 1}, {"contents": [{"type": "p", "value": "<span class=\"strong\">Peter</span>:        Hey Mike, can I ask you something?<br/>\n<span class=\"strong\">Mike</span>:        Sure. What's up?     <br/>\n<span class=\"strong\">Peter</span>:        Have you ever tried speed dating before?<br/>\n<span class=\"strong\">Mike</span>:        Yeah, I have, a couple of times. It was really fun. I met a few girls who were into the same kinds of things as me.<br><br>\n\n<span class=\"strong\">Peter</span>:        It must have been a good experience, then! I'm having the hardest time finding someone who thinks I'm interesting these days. Every time I try to speak to a girl that I like, they seem so bored by what I'm saying.<br/>\n<span class=\"strong\">Mike</span>:        Speed dating can be a daunting experience at first. You may have been a bit nervous, I guess. You have to focus on making an impact, which means that you only have a couple of minutes to show them how captivating you can be.<br><br>\n\n<span class=\"strong\">Peter</span>:        That must be easy for you! Everyone in the office is always thrilled to hear your stories. I'm the kind of rambling guy who can't even say a joke properly!<br/>\n<span class=\"strong\">Mike</span>:        You must think that it's the only way to get people engaged, but that's not true. Sometimes, it's what you don't say that makes the conversation interesting. Try to be more relaxed. Practice makes perfect! You might not have heard this before!<br/>\n<span class=\"strong\">Peter</span>:        Thanks for nothing, Mike ..."}], "template_override": 1, "type": "text", "title": "", "_data": [], "id": 2}], "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0}]}